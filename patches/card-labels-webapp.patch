diff --git a/src/components/Cards/use-suggested-label.js b/src/components/Cards/use-suggested-label.js
new file mode 100644
index 0000000..1fa4fab
--- /dev/null
+++ b/src/components/Cards/use-suggested-label.js
@@ -0,0 +1,57 @@
+import { useEffect, useState } from 'react';
+import { last } from 'ramda';
+
+import request from '../../utils/request';
+import { getActionAndCommand, getArgsValues } from './utils';
+
+const basename = (path) => last((path || '').split('/').filter(Boolean)) || '';
+
+// Suggests a card label from whatever the card is set to play - only for the
+// play-music commands, where there's an obvious name to offer. Other commands
+// (volume, timers, say-my-ip, sync, ...) have no natural "content name", so
+// callers just get an empty suggestion and fall back to manual entry.
+const useSuggestedLabel = (actionData) => {
+  const [suggestedLabel, setSuggestedLabel] = useState('');
+  const { command } = getActionAndCommand(actionData);
+
+  useEffect(() => {
+    let isCurrent = true;
+
+    const resolve = async () => {
+      if (command === 'play_album') {
+        const [, album] = getArgsValues(actionData);
+        if (isCurrent) setSuggestedLabel(album || '');
+        return;
+      }
+
+      if (command === 'play_folder') {
+        const [folder] = getArgsValues(actionData);
+        if (isCurrent) setSuggestedLabel(basename(folder));
+        return;
+      }
+
+      if (command === 'play_single') {
+        const [songUrl, provider] = getArgsValues(actionData);
+        if (!songUrl) {
+          if (isCurrent) setSuggestedLabel('');
+          return;
+        }
+        const { result } = await request('getSongByUrl', { song_url: songUrl, provider });
+        if (isCurrent) setSuggestedLabel(result?.[0]?.title || basename(songUrl));
+        return;
+      }
+
+      if (isCurrent) setSuggestedLabel('');
+    };
+
+    resolve();
+
+    return () => {
+      isCurrent = false;
+    };
+  }, [actionData, command]);
+
+  return suggestedLabel;
+};
+
+export default useSuggestedLabel;
