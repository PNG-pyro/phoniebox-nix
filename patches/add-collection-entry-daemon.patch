+def _validate_url(url):
+    if not isinstance(url, str) or '\n' in url or '\r' in url or '\x00' in url:
+        raise LibraryError(400, 'invalid_url', 'The URL is invalid.')
+    url = url.strip()
+    parsed = urlparse(url)
+    if parsed.scheme not in ('http', 'https') or not parsed.netloc:
+        raise LibraryError(400, 'invalid_url', 'The URL must be a valid http(s) address.')
+    return url
+
+
+def _check_url_reachable(url):
+    """Confirm the URL responds, without downloading its (possibly unbounded) body."""
+    try:
+        with requests.get(url, timeout=URL_FETCH_TIMEOUT_SECONDS, stream=True) as response:
+            if response.status_code >= 400:
+                raise LibraryError(
+                    422,
+                    'url_unreachable',
+                    f'The URL responded with status {response.status_code}.',
+                )
+    except requests.RequestException as error:
+        raise LibraryError(422, 'url_unreachable', f'Could not reach the URL: {error}') from error
+
