diff --git a/src/components/Library/lists/folders/collection-kinds.js b/src/components/Library/lists/folders/collection-kinds.js
new file mode 100644
--- /dev/null
+++ b/src/components/Library/lists/folders/collection-kinds.js
@@ -0,0 +1,22 @@
+import QueueMusicIcon from '@mui/icons-material/QueueMusic';
+
+// A "collection" is a library view where browsing into a folder that contains a
+// special marker file (m3u, podcast.txt, livestream.txt, ...) shows the marker's
+// resolved contents instead of a raw file listing - the same expansion the backend
+// already does for card playback (see playlistgenerator.py). Each entry here is one
+// such marker type, keyed by its view id (e.g. the "playlists" library tab).
+const COLLECTION_KINDS = {
+  playlist: {
+    markerType: 'playlist',
+    icon: QueueMusicIcon,
+    createLabelKey: 'library.folders.manager.create-playlist',
+    createDialogTitleKey: 'library.folders.manager.create-playlist-dialog.title',
+    createDialogNameKey: 'library.folders.manager.create-playlist-dialog.name',
+    bannerKey: 'library.folders.playlist-banner',
+    emptyKey: 'library.folders.empty-playlist',
+    seedFileName: (name) => `${name}.m3u`,
+    seedFileType: 'audio/x-mpegurl',
+  },
+};
+
+export default COLLECTION_KINDS;
