@@ -0,0 +1,59 @@
+import { useEffect, useState } from 'react';
+import { useTranslation } from 'react-i18next';
+
+import {
+  Box,
+  Fade,
+  IconButton,
+} from '@mui/material';
+import ArrowBackIcon from '@mui/icons-material/ArrowBack';
+
+import FolderLink from './folder-link';
+
+// Only show the shortcut once the real back row (top of the list) has scrolled out of view
+const SCROLL_THRESHOLD = 150;
+
+const FloatingBackBar = ({ dir }) => {
+  const { t } = useTranslation();
+  const [visible, setVisible] = useState(false);
+
+  useEffect(() => {
+    if (!dir) return undefined;
+
+    const onScroll = () => setVisible(window.scrollY > SCROLL_THRESHOLD);
+    onScroll();
+    window.addEventListener('scroll', onScroll, { passive: true });
+    return () => window.removeEventListener('scroll', onScroll);
+  }, [dir]);
+
+  if (!dir) return null;
+
+  return (
+    <Fade in={visible} unmountOnExit>
+      <Box
+        sx={{
+          position: 'fixed',
+          top: 0,
+          left: 0,
+          zIndex: 1100,
+          bgcolor: 'background.paper',
+          boxShadow: 3,
+          borderRadius: '0 0 50% 0',
+        }}
+      >
+        <IconButton
+          aria-label={t('library.folders.back-button-label')}
+          component={FolderLink}
+          data={{ dir }}
+          nativeButton={false}
+          size="large"
+          title={t('library.folders.back-button-label')}
+        >
+          <ArrowBackIcon />
+        </IconButton>
+      </Box>
+    </Fade>
+  );
+};
+
+export default FloatingBackBar;
