+// Playlists live at Playlists/<name>.
+// Returns <name> for a playlist folder path, or null for anything else.
+export const getPlaylistName = (path) => {
+  if (!path) return null;
+  const clean = path.replace(/^\.\//, '');
+  const match = clean.match(/^Playlists\/([^/]+)\/?$/);
+  return match ? match[1] : null;
+};
