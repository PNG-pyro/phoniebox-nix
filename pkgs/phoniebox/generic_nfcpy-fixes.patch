diff --git a/src/webapp/src/components/Library/add-to-playlist-dialog.js b/src/webapp/src/components/Library/add-to-playlist-dialog.js
new file mode 100644
index 0000000..95b028c
--- /dev/null
+++ b/src/webapp/src/components/Library/add-to-playlist-dialog.js
@@ -0,0 +1,105 @@
+import React, { useEffect, useState } from 'react';
+
+import {
+  Alert,
+  Button,
+  Dialog,
+  DialogActions,
+  DialogContent,
+  DialogTitle,
+  List,
+  ListItemButton,
+  ListItemIcon,
+  ListItemText,
+  TextField,
+} from '@mui/material';
+import AddIcon from '@mui/icons-material/Add';
+import QueueMusicIcon from '@mui/icons-material/QueueMusic';
+
+import request from '../../utils/request';
+
+// `item` is what the library item would play, e.g. { song_url } or { albumartist, album }
+const AddToPlaylistDialog = ({ open, onClose, item }) => {
+  const [playlists, setPlaylists] = useState([]);
+  const [isCreating, setIsCreating] = useState(false);
+  const [newName, setNewName] = useState('');
+  const [message, setMessage] = useState(null); // { severity, text }
+
+  // Fresh start each time the dialog opens
+  useEffect(() => {
+    if (!open) return;
+    setMessage(null);
+    setIsCreating(false);
+    setNewName('');
+    const load = async () => {
+      const { result, error } = await request('listPlaylists');
+      if (result) setPlaylists(result);
+      if (error) console.error(error);
+    };
+    load();
+  }, [open]);
+
+  const showError = (error) => setMessage({
+    severity: 'error',
+    text: String(error?.message || error),
+  });
+
+  const addTo = async (name) => {
+    const { result, error } = await request('addToPlaylist', { name, ...item });
+    if (error) return showError(error);
+    const skipped = result.skipped ? ` (${result.skipped} already in it)` : '';
+    setMessage({
+      severity: 'success',
+      text: `Added ${result.added} song${result.added === 1 ? '' : 's'} to ${name}${skipped}`,
+    });
+  };
+
+  const create = async () => {
+    const name = newName.trim();
+    if (!name) return;
+    const { error } = await request('createPlaylist', { name });
+    if (error) return showError(error);
+    setPlaylists((current) => [...current, name].sort());
+    setIsCreating(false);
+    setNewName('');
+    await addTo(name);
+  };
+
+  return (
+    <Dialog open={open} onClose={onClose} fullWidth>
+      <DialogTitle>Add to playlist</DialogTitle>
+      <DialogContent>
+        {message && <Alert severity={message.severity} sx={{ mb: 1 }}>{message.text}</Alert>}
+        <List>
+          {isCreating
+            ? <TextField
+                autoFocus
+                fullWidth
+                variant="standard"
+                label="New playlist name"
+                value={newName}
+                onChange={(e) => setNewName(e.target.value)}
+                onKeyDown={(e) => { if (e.key === 'Enter') create(); }}
+              />
+            : <ListItemButton onClick={() => setIsCreating(true)}>
+                <ListItemIcon><AddIcon /></ListItemIcon>
+                <ListItemText primary="New playlist…" />
+              </ListItemButton>
+          }
+          {playlists.map((name) => (
+            <ListItemButton key={name} onClick={() => addTo(name)}>
+              <ListItemIcon><QueueMusicIcon /></ListItemIcon>
+              <ListItemText primary={name} />
+            </ListItemButton>
+          ))}
+        </List>
+      </DialogContent>
+      <DialogActions>
+        {isCreating && <Button onClick={create} disabled={!newName.trim()}>Create &amp; add</Button>}
+        <Button onClick={onClose}>Close</Button>
+      </DialogActions>
+    </Dialog>
+  );
+};
+
+export default AddToPlaylistDialog;
