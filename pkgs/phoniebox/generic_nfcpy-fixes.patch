+import { useEffect, useRef, useState } from 'react';
+
+// Becomes true once the element has been on (or near) the screen for `delay` ms,
+// then stays true. Attach the returned ref to the element to watch.
+const useInView = ({ rootMargin = '300px', delay = 150 } = {}) => {
+  const ref = useRef(null);
+  const [inView, setInView] = useState(false);
+
+  useEffect(() => {
+    if (inView || !ref.current) return undefined;
+
+    // Very old browsers: just load everything, as before
+    if (!('IntersectionObserver' in window)) {
+      setInView(true);
+      return undefined;
+    }
+
+    let timer = null;
+    const observer = new IntersectionObserver(([entry]) => {
+      if (entry.isIntersecting) {
+        timer = setTimeout(() => setInView(true), delay);
+      } else if (timer) {
+        // Scrolled past before the pause was over: don't load
+        clearTimeout(timer);
+        timer = null;
+      }
+    }, { rootMargin });
+
+    observer.observe(ref.current);
+    return () => {
+      observer.disconnect();
+      if (timer) clearTimeout(timer);
+    };
+  }, [inView, rootMargin, delay]);
+
+  return [ref, inView];
+};
+
+export default useInView;
