+  }, [open]);
+
+  const showError = (error) => setMessage({
+    severity: 'error',
+    text: String(error?.message || error),
+  });
+
+  const addTo = async (name) => {
+    const { result, error } = await request('addToPlaylist', { name, ...item });
+    if (error) return showError(error);
+    const skipped = result.skipped ? ` (${result.skipped} already in it)` : '';
+    setMessage({
+      severity: 'success',
+      text: `Added ${result.added} song${result.added === 1 ? '' : 's'} to ${name}${skipped}`,
+    });
+  };
+
+  const create = async () => {
+    const name = newName.trim();
+    if (!name) return;
+    const { error } = await request('createPlaylist', { name });
+    if (error) return showError(error);
+    setPlaylists((current) => [...current, name].sort());
+    setIsCreating(false);
+    setNewName('');
+    await addTo(name);
+  };
+
+  return (
+    <Dialog open={open} onClose={onClose} fullWidth>
+      <DialogTitle>Add to playlist</DialogTitle>
+      <DialogContent>
+        {message && <Alert severity={message.severity} sx={{ mb: 1 }}>{message.text}</Alert>}
+        <List>
+          {isCreating
+            ? <TextField
+                autoFocus
+                fullWidth
+                variant="standard"
+                label="New playlist name"
+                value={newName}
+                onChange={(e) => setNewName(e.target.value)}
+                onKeyDown={(e) => { if (e.key === 'Enter') create(); }}
+              />
+            : <ListItemButton onClick={() => setIsCreating(true)}>
+                <ListItemIcon><AddIcon /></ListItemIcon>
+                <ListItemText primary="New playlist…" />
+              </ListItemButton>
+          }
+          {playlists.map((name) => (
+            <ListItemButton key={name} onClick={() => addTo(name)}>
+              <ListItemIcon><QueueMusicIcon /></ListItemIcon>
+              <ListItemText primary={name} />
+            </ListItemButton>
+          ))}
+        </List>
+      </DialogContent>
+      <DialogActions>
+        {isCreating && <Button onClick={create} disabled={!newName.trim()}>Create &amp; add</Button>}
+        <Button onClick={onClose}>Close</Button>
+      </DialogActions>
+    </Dialog>
+  );
+};
+
+export default AddToPlaylistDialog;
