+import { useEffect, useRef } from 'react';
+
+// Walk up from an element to the nearest ancestor that actually scrolls
+const findScrollParent = (element) => {
+  let node = element && element.parentElement;
+  while (node) {
+    const { overflowY } = window.getComputedStyle(node);
+    if ((overflowY === 'auto' || overflowY === 'scroll') && node.scrollHeight > node.clientHeight) {
+      return node;
+    }
+    node = node.parentElement;
+  }
+  return document.scrollingElement;
+};
+
+// Remembers how far a list was scrolled (per browser tab) and restores it once `ready` is true.
+// Returns a ref: attach it to an element inside the list, e.g. <div ref={scrollRef} />
+const useScrollMemory = (key, ready) => {
+  const anchorRef = useRef(null);
+
+  useEffect(() => {
+    if (!ready || !anchorRef.current) return undefined;
+    const scroller = findScrollParent(anchorRef.current);
+    if (!scroller) return undefined;
+
+    // Restore, one frame later so the list has been laid out
+    let saved = null;
+    try {
+      saved = sessionStorage.getItem(key);
+    } catch (error) {
+      // storage unavailable (e.g. private mode); just don't restore
+    }
+    if (saved !== null) {
+      requestAnimationFrame(() => { scroller.scrollTop = Number(saved); });
+    }
+
+    // Save while scrolling, at most once per frame
+    let frame = null;
+    const onScroll = () => {
+      if (frame) return;
+      frame = requestAnimationFrame(() => {
+        frame = null;
+        // Skip if the list is being torn down (its marker is gone),
+        // so leaving the page can't overwrite the position with 0
+        if (!anchorRef.current || !anchorRef.current.isConnected) return;
+        try {
+          sessionStorage.setItem(key, String(scroller.scrollTop));
+        } catch (error) {
+          // ignore
+        }
+      });
+    };
+
+    // When the page itself scrolls, the scroll events go to `window`, not the element
+    const eventTarget = scroller === document.scrollingElement ? window : scroller;
+    eventTarget.addEventListener('scroll', onScroll, { passive: true });
+    return () => {
+      eventTarget.removeEventListener('scroll', onScroll);
+      if (frame) cancelAnimationFrame(frame);
+    };
+  }, [key, ready]);
+
+  return anchorRef;
+};
+
+export default useScrollMemory;
