@@ -0,0 +1,178 @@
+import React, { useState } from 'react';
+import { useLocation, useNavigate } from 'react-router-dom';
+import { useTranslation } from 'react-i18next';
+
+import {
+  Button,
+  Dialog,
+  DialogActions,
+  DialogContent,
+  DialogContentText,
+  DialogTitle,
+  Grid,
+  IconButton,
+  TextField,
+  Typography,
+} from '@mui/material';
+import DeleteOutlineIcon from '@mui/icons-material/DeleteOutline';
+import EditOutlinedIcon from '@mui/icons-material/EditOutlined';
+import PlayCircleFilledRoundedIcon from '@mui/icons-material/PlayCircleFilledRounded';
+import PlaylistAddIcon from '@mui/icons-material/PlaylistAdd';
+
+import request from '../../../../utils/request';
+import AddToPlaylistDialog from '../../add-to-playlist-dialog';
+
+const CARDS_NOTE = 'Cards using this playlist will need to be reassigned afterwards.';
+
+const PlaylistBanner = ({ name, folder, songCount, isSelecting, registerMusicToCard }) => {
+  const { t } = useTranslation();
+  const navigate = useNavigate();
+  const { search: urlSearch } = useLocation();
+
+  const [addOpen, setAddOpen] = useState(false);
+  const [renameOpen, setRenameOpen] = useState(false);
+  const [deleteOpen, setDeleteOpen] = useState(false);
+  const [newName, setNewName] = useState(name);
+  const [error, setError] = useState(null);
+
+  const folderArgs = { folder, recursive: true };
+  const isEmpty = songCount === 0;
+
+  const goTo = (dir) => navigate(
+    `/library/playlists/${encodeURIComponent(dir)}${urlSearch}`,
+    { replace: true },
+  );
+
+  const rename = async () => {
+    const target = newName.trim();
+    if (!target || target === name) return setRenameOpen(false);
+    const { error } = await request('renamePlaylist', { name, new_name: target });
+    if (error) return setError(String(error?.message || error));
+    setRenameOpen(false);
+    goTo(`Playlists/${target}`);
+  };
+
+  const remove = async () => {
+    const { error } = await request('deletePlaylist', { name });
+    if (error) return setError(String(error?.message || error));
+    setDeleteOpen(false);
+    goTo('Playlists');
+  };
+
+  return (
+    <>
+      <Grid container sx={{ padding: '16px 8px 0' }}>
+        <Grid item xs={12}>
+          <Typography variant="h6" sx={{ fontWeight: 'bold' }} component="h1">
+            {name}
+          </Typography>
+          <Typography>
+            {songCount === 1 ? '1 song' : `${songCount} songs`}
+          </Typography>
+          {isEmpty &&
+            <Typography variant="body2" color="text.secondary">
+              Empty. Use + in the library to add songs.
+            </Typography>
+          }
+        </Grid>
+      </Grid>
+
+      <Grid container sx={{ padding: '0 8px' }}>
+        <Grid item xs={12}
+          sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}
+        >
+          <div>
+            {!isSelecting &&
+              <>
+                <IconButton
+                  aria-label="Rename playlist"
+                  onClick={() => { setNewName(name); setError(null); setRenameOpen(true); }}
+                >
+                  <EditOutlinedIcon />
+                </IconButton>
+                <IconButton
+                  aria-label="Delete playlist"
+                  onClick={() => { setError(null); setDeleteOpen(true); }}
+                >
+                  <DeleteOutlineIcon />
+                </IconButton>
+              </>
+            }
+          </div>
+          <div style={{ display: 'flex', alignItems: 'center' }}>
+            {isSelecting
+              ? <Button
+                  variant="outlined"
+                  onClick={() => registerMusicToCard('play_folder', folderArgs)}
+                  sx={{ margin: '20px 0 4px' }}
+                >
+                  {t('library.albums.assign-to-card')}
+                </Button>
+              : <>
+                  <IconButton
+                    aria-label="Add to playlist"
+                    onClick={() => setAddOpen(true)}
+                    disabled={isEmpty}
+                    sx={{ fontSize: 40 }}
+                  >
+                    <PlaylistAddIcon fontSize="inherit" />
+                  </IconButton>
+                  <IconButton
+                    aria-label="Play"
+                    onClick={() => request('play_folder', folderArgs)}
+                    disabled={isEmpty}
+                    sx={{ fontSize: 64 }}
+                  >
+                    <PlayCircleFilledRoundedIcon color="primary" fontSize="inherit" />
+                  </IconButton>
+                </>
+            }
+          </div>
+        </Grid>
+      </Grid>
+
+      <AddToPlaylistDialog
+        open={addOpen}
+        onClose={() => setAddOpen(false)}
+        item={folderArgs}
+      />
+
+      <Dialog open={renameOpen} onClose={() => setRenameOpen(false)} fullWidth>
+        <DialogTitle>Rename playlist</DialogTitle>
+        <DialogContent>
+          <TextField
+            autoFocus
+            fullWidth
+            variant="standard"
+            label="Name"
+            value={newName}
+            onChange={(e) => setNewName(e.target.value)}
+            onKeyDown={(e) => { if (e.key === 'Enter') rename(); }}
+          />
+          <DialogContentText sx={{ mt: 2 }}>{CARDS_NOTE}</DialogContentText>
+          {error && <DialogContentText color="error">{error}</DialogContentText>}
+        </DialogContent>
+        <DialogActions>
+          <Button onClick={() => setRenameOpen(false)}>Cancel</Button>
+          <Button onClick={rename} disabled={!newName.trim()}>Rename</Button>
+        </DialogActions>
+      </Dialog>
+
+      <Dialog open={deleteOpen} onClose={() => setDeleteOpen(false)}>
+        <DialogTitle>Delete "{name}"?</DialogTitle>
+        <DialogContent>
+          <DialogContentText>
+            The playlist is removed; the songs themselves stay in your library. {CARDS_NOTE}
+          </DialogContentText>
+          {error && <DialogContentText color="error">{error}</DialogContentText>}
+        </DialogContent>
+        <DialogActions>
+          <Button onClick={() => setDeleteOpen(false)}>Cancel</Button>
+          <Button onClick={remove} color="error">Delete</Button>
+        </DialogActions>
+      </Dialog>
+    </>
+  );
+};
+
+export default PlaylistBanner;
